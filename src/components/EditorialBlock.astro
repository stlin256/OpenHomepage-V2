---
/**
 * 编辑风格区块：编号列表、磁贴、归档卡、按钮组与分割线的统一容器。
 * 数据来自 site.yaml editorial_blocks，通过 home.layout 的 editorial id 挂载。
 */
import { resolveText } from '../lib/localize.ts';

const { block, lang } = Astro.props;
const title = resolveText(block.title, lang);
const tag = block.tag ? resolveText(block.tag, lang) : '';
const description = block.description ? resolveText(block.description, lang) : '';
const assetUrl = (path: string) => (path.startsWith('/') ? path : `/${path}`);
---

<section class="home-block block-editorial reveal" style={`--section-color:${block.color || 'var(--accent)'}`}>
  <header class="section-header reveal">
    {tag && <span class="section-tag">{tag}</span>}
    <span class="section-rule" aria-hidden="true"></span>
  </header>

  <div class="editorial-heading">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>

  {block.actions && block.actions.length > 0 && (
    <div class="button-row reveal">
      {block.actions.map((action) => {
        const label = resolveText(action.label, lang);
        const variant = action.variant ?? 'outline';
        return action.url ? (
          <a
            class={`editorial-button ${variant}`}
            href={action.url}
            target={action.url.startsWith('/') ? undefined : '_blank'}
            rel={action.url.startsWith('/') ? undefined : 'noopener noreferrer'}
          >
            <span>{label}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        ) : (
          <button class={`editorial-button ${variant}`} type="button">
            <span>{label}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        );
      })}
    </div>
  )}

  {block.list && block.list.length > 0 && (
    <div class="editorial-list">
      {block.list.map((item, index) => {
        const itemTitle = resolveText(item.title, lang);
        const meta = item.meta ? resolveText(item.meta, lang) : '';
        const itemDescription = item.description ? resolveText(item.description, lang) : '';
        const body = (
          <>
            {item.image && (
              <span class="editorial-item-mask" style={`background-image:url('${assetUrl(item.image)}')`} aria-hidden="true" />
            )}
            <span class="editorial-item-index">{String(index + 2).padStart(2, '0')}</span>
            <span class="editorial-item-content">
              <span class="editorial-item-title">{itemTitle}</span>
              {meta && <span class="editorial-item-meta">{meta}</span>}
              {itemDescription && <span class="editorial-item-description">{itemDescription}</span>}
            </span>
          </>
        );
        return item.url ? (
          <a class="editorial-item reveal" href={item.url} style={`--delay:${index * 80}ms`}>
            {body}
          </a>
        ) : (
          <article class="editorial-item reveal" style={`--delay:${index * 80}ms`}>
            {body}
          </article>
        );
      })}
    </div>
  )}

  {block.tiles && block.tiles.length > 0 && (
    <div class="editorial-tiles">
      {block.tiles.map((tile) => {
        const tileTitle = resolveText(tile.title, lang);
        const kicker = tile.kicker ? resolveText(tile.kicker, lang) : '';
        return (
          <a
            class:list={['editorial-tile reveal', tile.size ?? 'small']}
            href={tile.url ?? '#'}
            style={`--tile-image:url('${tile.image ? assetUrl(tile.image) : ''}');--delay:0ms`}
          >
            <span class="tile-content">
              {kicker && <span class="tile-kicker">{kicker}</span>}
              <span class="tile-title">{tileTitle}</span>
            </span>
          </a>
        );
      })}
    </div>
  )}

  {block.archive && block.archive.length > 0 && (
    <div class="archive-grid">
      {block.archive.map((card, index) => {
        const cardTitle = resolveText(card.title, lang);
        const status = card.status ? resolveText(card.status, lang) : 'Archive';
        const cardDescription = card.description ? resolveText(card.description, lang) : '';
        const body = (
          <>
            <span
              class="archive-media"
              style={card.image ? `background-image:url('${assetUrl(card.image)}')` : ''}
              aria-hidden="true"
            />
            <span class="archive-body">
              <span class="archive-status">{status}</span>
              <span class="archive-title">{cardTitle}</span>
              {cardDescription && <span class="archive-description">{cardDescription}</span>}
            </span>
          </>
        );
        return card.url ? (
          <a class="archive-card reveal" href={card.url} style={`--delay:${index * 90}ms`}>
            {body}
          </a>
        ) : (
          <article class="archive-card reveal" style={`--delay:${index * 90}ms`}>
            {body}
          </article>
        );
      })}
    </div>
  )}

  {block.divider && <hr class="editorial-divider" />}
</section>
