---
/**
 * 全站动态路由：getStaticPaths 从 data/（缺失时回退 data.example/，见 src/lib/data-dir.ts）
 * 的 pages/<lang>/*.md 生成。默认语言无前缀，其他语言带 /lang/ 前缀；
 * 缺失译文按回退链渲染并显示提示条（docs/specs/11）。
 * 主页（slug 为 /）按 site.yaml home.layout 顺序渲染区块：profile / markdown /
 * streaming / github / rss（M4b 实体区块，数据来自 .cache 与 streaming/ 内容文件）。
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '../lib/markdown.ts';
import {
  loadSiteConfig,
  loadPages,
  loadRssConfig,
  detectLanguages,
  isI18nEnabled,
  resolveText,
  resolveAvatarPosition,
  resolveBgm,
  resolveFavicon,
  type SiteConfig,
} from '../lib/config.ts';
import {
  normalizeLang,
  buildRoutes,
  navPagesForLang,
  alternateLinks,
  type RouteEntry,
  type NavItem,
} from '../lib/routes.ts';
import { buildAccentTheme, type AccentTheme } from '../lib/theme.ts';
import { planHomeBlocks, type PlannedHomeBlock } from '../lib/home.ts';
import { resolveFooter, footerTextToHtml } from '../lib/footer.ts';
import { resolveDataDir } from '../lib/data-dir.ts';
import { loadGithubCache, buildGithubView, repoCardHtml, type GithubView } from '../lib/github-block.ts';
import { loadRssCache, buildRssView, type RssView } from '../lib/rss-block.ts';
import {
  loadStreamingBlock,
  streamEmbedHtml,
  type LoadedStreamBlock,
} from '../lib/stream.ts';
import GithubBlock from '../components/blocks/GithubBlock.astro';
import RssBlock from '../components/blocks/RssBlock.astro';
import StreamBlock from '../components/blocks/StreamBlock.astro';

interface Props {
  route: RouteEntry;
  site: SiteConfig;
  i18n: boolean;
  defaultLang: string;
  accent: AccentTheme;
  nav: NavItem[];
  alternates: { lang: string; path: string }[];
  avatarUrl?: string;
  /** 背景音乐（resolveBgm 归一化 + 文件存在性检查后为 undefined 即不渲染） */
  bgm?: { src: string; volume: number };
  /** favicon URL（site.favicon 指向的真实文件存在时为 /assets/...，否则内置默认 /favicon.svg） */
  favicon: string;
  blocks: PlannedHomeBlock[];
  /** .cache/github.json 视图（M4b）；null = 缓存缺失（渲染空态） */
  githubView: GithubView | null;
  /** .cache/rss.json 视图；null = 缓存缺失或 rss 未启用 */
  rssView: RssView | null;
}

export function getStaticPaths() {
  const dataDir = resolveDataDir(process.cwd());
  const site = loadSiteConfig(dataDir);
  const pages = loadPages(dataDir);
  const langs = detectLanguages(pages);
  const i18n = isI18nEnabled(langs);
  const defaultLang = normalizeLang(site.site.language) ?? langs[0] ?? 'zh';
  const accent = buildAccentTheme(site.theme?.accent);
  // 头像：仅在文件真实存在时输出 <img>，避免示例数据下 404
  const avatar = site.profile.avatar;
  const avatarUrl = avatar && existsSync(path.join(dataDir, avatar)) ? `/${avatar}` : undefined;
  // 背景音乐：仅在文件真实存在时输出 <audio>，避免示例数据下 404
  const bgm = resolveBgm(site);
  const bgmSrc = bgm && existsSync(path.join(dataDir, bgm.file)) ? `/${bgm.file}` : undefined;
  // favicon：配置了且文件真实存在用之；否则回退内置默认（public/favicon.svg → /favicon.svg）
  const favicon = resolveFavicon(site);
  const faviconUrl = favicon && existsSync(path.join(dataDir, favicon)) ? `/${favicon}` : '/favicon.svg';
  const rssEnabled = !!site.rss && site.rss.enabled !== false;
  // rss.enabled: false 时整区不渲染（即使 home.layout 引用了 rss 区块）
  const blocks = planHomeBlocks(site.home?.layout).filter((b) => b.block !== 'rss' || rssEnabled);
  // M4b：prefetch 缓存 → 区块视图（缺文件时各 load* 返回 null + warning，区块渲染空态；
  // 缺数即报错的闸口在 prefetch，见 docs/specs/07 §4）
  const cacheDir = path.join(process.cwd(), '.cache');
  const githubView = buildGithubView(loadGithubCache(cacheDir));
  const rssView = rssEnabled
    ? buildRssView(loadRssCache(cacheDir), loadRssConfig(dataDir, site.rss?.sources_file))
    : null;

  return buildRoutes(pages, langs, defaultLang).map((route) => ({
    params: { slug: route.param },
    props: {
      route,
      site,
      i18n,
      defaultLang,
      accent,
      nav: navPagesForLang(pages, route.lang, defaultLang),
      alternates: alternateLinks(pages, route.slug, langs, defaultLang),
      avatarUrl,
      bgm: bgmSrc && bgm ? { src: bgmSrc, volume: bgm.volume } : undefined,
      favicon: faviconUrl,
      blocks,
      githubView,
      rssView,
    } satisfies Props,
  }));
}

const {
  route,
  site,
  i18n,
  defaultLang,
  accent,
  nav,
  alternates,
  avatarUrl,
  bgm,
  favicon,
  blocks,
  githubView,
  rssView,
} = Astro.props;
const isHome = route.slug === '/';
const contentLang = route.page.lang;
// 页脚：默认开启（footer.enabled:false 关闭）；文本按内容语言解析后渲染内联链接
const footerCfg = resolveFooter(site);
const footerHtml = footerCfg
  ? footerTextToHtml(resolveText(footerCfg.text, contentLang))
  : null;
// 头像布局：side=侧边杂志分栏（默认）；top=头像在姓名/简介上方居顶
const avatarTop = resolveAvatarPosition(site.profile) === 'top';

// 流式区块：按内容语言沿回退链加载全部定义（页面语言 → en → 默认语言）；
// 主页 streaming 区块与正文 ::stream{id} 占位共用同一份加载结果
const dataDir = resolveDataDir(process.cwd());
const streamBlocks: LoadedStreamBlock[] = [];
for (const def of site.streaming_blocks ?? []) {
  const b = await loadStreamingBlock(dataDir, def, contentLang, defaultLang);
  if (b) streamBlocks.push(b);
}
const streamById = new Map(streamBlocks.map((b) => [b.id, b]));
const streamEmbeds = Object.fromEntries(streamBlocks.map((b) => [b.id, streamEmbedHtml(b)]));
// ::ghcard{repo} 占位 ← pinned 缓存数据（大小写不敏感匹配；1:1 官网仓库卡，随页面语言）
const ghHtmlByRepo = Object.fromEntries(
  (githubView?.pinned?.repos ?? []).map((r) => [
    r.full_name.toLowerCase(),
    repoCardHtml(r, { lang: contentLang === 'zh' ? 'zh' : 'en' }),
  ]),
);
const bodyHtml = await renderMarkdown(route.page.body, {
  streamEmbeds,
  ghCards: { htmlByRepo: ghHtmlByRepo },
});
---

<BaseLayout
  title={route.page.title}
  siteTitle={resolveText(site.site.title, contentLang)}
  description={route.page.description ?? (site.site.description ? resolveText(site.site.description, contentLang) : undefined)}
  htmlLang={contentLang}
  lang={route.lang}
  defaultLang={defaultLang}
  accent={accent}
  defaultMode={site.theme?.default_mode ?? 'system'}
  nav={nav}
  currentPath={route.path}
  i18n={i18n}
  alternates={alternates}
  bgm={bgm}
  favicon={favicon}
  footer={footerHtml}
>
  {route.fallback && (
    <p class="fallback-banner" role="note">
      {/* 该提示恰恰出现在没有译文的页面上，故中英双语两行各写一遍 */}
      <span class="fallback-line">暂无译文，以下为其他语言版本。</span>
      <span class="fallback-line">Translation not available; showing a fallback version.</span>
    </p>
  )}
  {
    isHome ? (
      <div class="home">
        {blocks.map((b) =>
          b.block === 'profile' ? (
            <section
              class:list={[
                'home-block block-profile reveal',
                avatarTop ? 'profile-top' : 'mag-grid',
              ]}
            >
              <div class:list={['profile-intro', { 'span-7': !avatarTop }]}>
                <h1 class="profile-name">{resolveText(site.profile.name, contentLang)}</h1>
                {site.profile.tagline && (
                  <p class="profile-tagline">{resolveText(site.profile.tagline, contentLang)}</p>
                )}
                {site.profile.links && site.profile.links.length > 0 && (
                  <ul class="profile-links">
                    {site.profile.links.map((l) => (
                      <li>
                        <a href={l.url}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div
                class:list={['profile-avatar', { 'span-5': !avatarTop }]}
                {...(avatarTop ? {} : { 'data-parallax': true })}
              >
                {avatarUrl && <img src={avatarUrl} alt={resolveText(site.profile.name, contentLang)} loading="lazy" />}
              </div>
            </section>
          ) : b.block === 'markdown' ? (
            <section class="home-block block-markdown reveal">
              <div class="markdown-body" set:html={bodyHtml} />
            </section>
          ) : b.block === 'streaming' ? (
            // 未定义的 id 在 loadStreamingBlock 已 warning，这里跳过渲染
            streamById.has(b.id ?? '') ? <StreamBlock block={streamById.get(b.id ?? '')!} /> : null
          ) : b.block === 'github' ? (
            <GithubBlock
              view={githubView}
              lang={contentLang}
              accent={accent}
              showContributions={site.github.show_contributions !== false}
            />
          ) : b.block === 'rss' ? (
            <RssBlock
              view={rssView}
              title={resolveText(site.rss?.block_title ?? 'RSS', contentLang)}
              lang={contentLang}
            />
          ) : null,
        )}
      </div>
    ) : (
      <article class="page-content">
        <h1>{route.page.title}</h1>
        <div class="markdown-body" set:html={bodyHtml} />
      </article>
    )
  }
</BaseLayout>
