---
/**
 * 站点外壳：<head>（meta / 字体 / KaTeX / hreflang / 主题初始化脚本）、
 * 桌面左上竖排 tab 导航 + 移动端汉堡抽屉、语言切换器、主题切换按钮。
 * 所有数据经 props 传入（路由层在 getStaticPaths 算好），本组件不含配置读取逻辑。
 *
 * 决策：KaTeX CSS 全站加载（katex.min.css，字体按需下载），避免逐页检测公式的复杂度。
 * 页脚：site.yaml footer 段（默认开启，显式 false 关闭；内联链接见 src/lib/footer.ts）。
 */
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import type { AccentTheme } from '../lib/theme.ts';
import type { BackgroundTheme } from '../lib/theme.ts';
import type { ResolvedIntroCard } from '../lib/config.ts';
import ContactCard from '../components/ContactCard.astro';
import type { NavItem } from '../lib/routes.ts';
import { withBase, getBaseUrl } from '../lib/base-url.ts';

interface Props {
  /** 页面标题（<title> 为 `${title} · ${siteTitle}`） */
  title: string;
  siteTitle: string;
  description?: string;
  /** 实际内容语言（回退时为内容语言，非 URL 语言） */
  htmlLang: string;
  /** 当前 URL 语言（语言切换器高亮用） */
  lang: string;
  defaultLang: string;
  accent: AccentTheme;
  background: BackgroundTheme;
  defaultMode: 'system' | 'light' | 'dark';
  nav: NavItem[];
  currentPath: string;
  i18n: boolean;
  alternates: { lang: string; path: string }[];
  /** 背景音乐（site.yaml bgm 段，缺省不渲染；交互见 src/scripts/bgm.ts） */
  bgm?: { src: string; volume: number; autoplay: boolean };
  /** favicon URL（路由层已决定：配置的文件存在时为 /assets/...，否则内置默认 /favicon.svg） */
  favicon: string;
  /** 页脚 HTML（路由层 resolveFooter + footerTextToHtml 渲染；null = 关闭） */
  footer?: string | null;
  introCard?: ResolvedIntroCard | null;
}

const {
  title,
  siteTitle,
  description,
  htmlLang,
  lang,
  defaultLang,
  accent,
  background,
  defaultMode,
  nav,
  currentPath,
  i18n,
  alternates,
  bgm,
  favicon,
  footer,
  introCard,
} = Astro.props;

const baseUrl = getBaseUrl();
const langLabel = (l: string) => ({ zh: '中文', en: 'English' })[l] ?? l;
// 可视化编辑（M12a）：仅 admin 拉起的 dev server（OH_EDIT=1 且注入 OH_ADMIN_ORIGIN）
// 输出编辑 bootstrap；生产构建/外部 dev server 无此环境变量，整段不输出、零开销
const editAdminOrigin = process.env.OH_EDIT === '1' ? (process.env.OH_ADMIN_ORIGIN ?? '') : '';
const xDefault = alternates.find((a) => a.lang === defaultLang) ?? alternates[0];
/** 构建期注入的 accent 变量（global.css 中 --accent 引用这四个值） */
const themeVars = `--accent-light:${accent.light.accent};--accent-light-contrast:${accent.light.contrast};--accent-dark:${accent.dark.accent};--accent-dark-contrast:${accent.dark.contrast};--site-bg-light:${background.light};--site-bg-dark:${background.dark};`;
const FAVICON_MIME: Record<string, string> = {
  '.svg': 'image/svg+xml',
  '.png': 'image/png',
  '.ico': 'image/x-icon',
};
const faviconType = FAVICON_MIME[favicon.slice(favicon.lastIndexOf('.')).toLowerCase()];
const homeHref = withBase(nav.find((item) => item.slug === '/')?.path ?? '/');
---

<html
  lang={htmlLang}
  data-route-lang={lang}
  data-theme="light"
  data-default-mode={defaultMode}
  data-default-lang={defaultLang}
  data-base={baseUrl}
  style={themeVars}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · ${siteTitle}`}</title>
    <link rel="icon" href={withBase(favicon)} type={faviconType} />
    {description && <meta name="description" content={description} />}
    <script is:inline define:vars={{ defaultMode }}>
      // 首帧绘制前确定主题，避免闪烁：sessionStorage 用户选择 > site.yaml default_mode > 跟随系统。
      // 与 src/scripts/theme.ts 的 currentTheme 同一套规则（is:inline 无法 import，此处内联镜像）。
      // html.js 标记：滚动显现等动效的初始隐藏态只在有 JS 时生效（无 JS 不隐藏内容）
      (function () {
        document.documentElement.classList.add('js');
        var saved = null;
        try {
          saved = sessionStorage.getItem('theme');
        } catch (e) {}
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : defaultMode === 'light' || defaultMode === 'dark'
              ? defaultMode
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {i18n && (
      <script is:inline define:vars={{ defaultLang, baseUrl }}>
        // 语言偏好在首帧绘制前解析：已保存选择 > 浏览器语言。URL 语言不一致时直接
        // replace 到目标路由，避免先渲染默认语言再被模块脚本换内容造成闪动。
        (function () {
          var normalize = function (value) {
            var lang = (value || '').toLowerCase().split(/[-_]/)[0];
            return lang === 'zh' || lang === 'en' ? lang : null;
          };
          var preferred = null;
          try {
            preferred = normalize(localStorage.getItem('oh-language'));
          } catch (e) {}
          if (!preferred) preferred = normalize(navigator.language);
          var current = document.documentElement.dataset.routeLang
            ? normalize(document.documentElement.dataset.routeLang)
            : null;
          if (!preferred || !current || preferred === current) return;

          var cleanBase = (baseUrl || '/').replace(/\/+$/, '');
          var fullPath = location.pathname || '/';
          var unbased = fullPath;
          if (cleanBase && (fullPath === cleanBase || fullPath.indexOf(cleanBase + '/') === 0)) {
            unbased = fullPath.slice(cleanBase.length) || '/';
          }
          var rest = unbased;
          var prefix = '/' + current;
          if (rest === prefix || rest.indexOf(prefix + '/') === 0) {
            rest = rest.slice(prefix.length) || '/';
          }
          var targetPath = preferred === defaultLang
            ? (rest || '/')
            : (rest === '/' ? '/' + preferred + '/' : '/' + preferred + rest);
          var newPath = (cleanBase ? cleanBase : '') + (targetPath.charAt(0) === '/' ? targetPath : '/' + targetPath);
          location.replace(newPath + location.search + location.hash);
        })();
      </script>
    )}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(withBase(a.path), Astro.site)} />)}
    {i18n && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(withBase(xDefault.path), Astro.site)} />}
  </head>
  <body>
    <header class="site-header">
      <button class="nav-toggle" type="button" aria-label="打开导航菜单 / Menu" aria-expanded="false" aria-controls="site-nav">
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="站点导航">
        <p class="site-title"><a href={homeHref}>{siteTitle}</a></p>
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={withBase(item.path)}
                class:list={[{ active: item.path === currentPath }]}
                aria-current={item.path === currentPath ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-tools">
        {bgm && (
          <button class="bgm-toggle icon-btn" type="button" aria-pressed="false" aria-label="播放/暂停背景音乐 / Toggle background music">
            <svg class="icon icon-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
            </svg>
            <svg class="icon icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7" />
              <path d="M18.5 5.5a9.5 9.5 0 0 1 0 13" />
            </svg>
          </button>
        )}
        {i18n && alternates.length > 1 && (
          <div class="lang-switcher">
            <button class="lang-toggle icon-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="语言切换 / Switch language">
              {/* Material translate 图标（fill，与主题按钮同款小方块风格） */}
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z" />
              </svg>
            </button>
            <ul class="lang-menu" role="menu">
              {alternates.map((a) => (
                <li role="none">
                  <a
                    href={withBase(a.path)}
                    hreflang={a.lang}
                    role="menuitem"
                    class:list={[{ active: a.lang === lang }]}
                    aria-current={a.lang === lang ? 'true' : undefined}
                  >
                    {langLabel(a.lang)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <button class="theme-toggle icon-btn" type="button" aria-label="切换亮色/暗色主题 / Toggle theme">
          <svg class="icon icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="icon icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
          </svg>
        </button>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    {/* 页脚（默认开启，site.yaml footer.enabled:false 关闭；文本支持内联链接，见 src/lib/footer.ts） */}
    {footer && <footer class="site-footer" set:html={footer} />}
    {/* 背景音乐：audio 不参与内容交换，天然连续播放 */}
    {bgm && (
      <audio
        class="bgm-audio"
        src={withBase(bgm.src)}
        loop
        preload={bgm.autoplay ? 'auto' : 'none'}
        data-volume={bgm.volume}
        data-autoplay={bgm.autoplay ? 'true' : 'false'}
      />
    )}
    {/* 图片灯箱骨架（spec 03 §5）：交互在 src/scripts/lightbox.ts，开/关动画在 global.css */}
    {introCard && <ContactCard card={introCard} />}
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="图片预览 / Image preview" hidden>
      <img class="lightbox-img" alt="" />
      <button class="lightbox-close" type="button" aria-label="关闭 / Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <script>
      // 前端交互入口：首屏 + 客户端内容交换后初始化
      import '../scripts/interactions.ts';
    </script>
    {editAdminOrigin && (
      <script is:inline define:vars={{ adminOrigin: editAdminOrigin }}>
        // 可视化编辑 bootstrap（M12a）：?edit=1 或 sessionStorage 已标记 → 置标记、
        // 摘掉 query、动态加载 admin 托管的 overlay.js/overlay.css；「退出编辑」在 overlay 顶栏。
        (function () {
          try {
            var params = new URLSearchParams(location.search);
            var active = sessionStorage.getItem('oh-edit') === '1';
            if (params.get('edit') === '1') {
              sessionStorage.setItem('oh-edit', '1');
              active = true;
              params.delete('edit');
              var q = params.toString();
              history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
            }
            if (!active) return;
            window.__OH_ADMIN_ORIGIN__ = adminOrigin;
            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = adminOrigin + '/overlay.css';
            document.head.appendChild(link);
            var s = document.createElement('script');
            s.src = adminOrigin + '/overlay.js';
            document.head.appendChild(s);
          } catch (e) {}
        })();
      </script>
    )}
  </body>
</html>