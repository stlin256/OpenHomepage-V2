---
/**
 * 站点外壳：<head>（meta / 字体 / KaTeX / hreflang / 主题初始化脚本）、
 * 桌面左上竖排 tab 导航 + 移动端汉堡抽屉、语言切换器、主题切换按钮。
 * 所有数据经 props 传入（路由层在 getStaticPaths 算好），本组件不含配置读取逻辑。
 *
 * 决策：KaTeX CSS 全站加载（katex.min.css，字体按需下载），避免逐页检测公式的复杂度。
 * 决策：页脚未实现——design.md §4 提到页脚字段，但 spec 01 的 site.yaml schema 尚无定义。
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { AccentTheme } from '../lib/theme.ts';
import type { NavItem } from '../lib/routes.ts';

interface Props {
  /** 页面标题（<title> 为 `${title} · ${siteTitle}`） */
  title: string;
  siteTitle: string;
  description?: string;
  /** 实际内容语言（回退时为内容语言，非 URL 语言） */
  htmlLang: string;
  /** 当前 URL 语言（语言切换器高亮用） */
  lang: string;
  defaultLang: string;
  accent: AccentTheme;
  defaultMode: 'system' | 'light' | 'dark';
  nav: NavItem[];
  currentPath: string;
  i18n: boolean;
  alternates: { lang: string; path: string }[];
  /** 背景音乐（site.yaml bgm 段，缺省不渲染；交互见 src/scripts/bgm.ts） */
  bgm?: { src: string; volume: number };
}

const {
  title,
  siteTitle,
  description,
  htmlLang,
  lang,
  defaultLang,
  accent,
  defaultMode,
  nav,
  currentPath,
  i18n,
  alternates,
  bgm,
} = Astro.props;

const langLabel = (l: string) => ({ zh: '中文', en: 'English' })[l] ?? l;
const xDefault = alternates.find((a) => a.lang === defaultLang) ?? alternates[0];
/** 构建期注入的 accent 变量（global.css 中 --accent 引用这四个值） */
const accentVars = `--accent-light:${accent.light.accent};--accent-light-contrast:${accent.light.contrast};--accent-dark:${accent.dark.accent};--accent-dark-contrast:${accent.dark.contrast};`;
---

<html lang={htmlLang} data-theme="light" data-default-mode={defaultMode} style={accentVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · ${siteTitle}`}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline define:vars={{ defaultMode }}>
      // 首帧绘制前确定主题，避免闪烁：sessionStorage 用户选择 > site.yaml default_mode > 跟随系统。
      // 与 src/scripts/theme.ts 的 currentTheme 同一套规则（is:inline 无法 import，此处内联镜像）。
      // 注意：本脚本只在首次加载/整页刷新时执行；ClientRouter 转场后由 theme.ts 的
      // astro:after-swap 监听重放（#4）。
      // html.js 标记：滚动显现等动效的初始隐藏态只在有 JS 时生效（无 JS 不隐藏内容）
      (function () {
        document.documentElement.classList.add('js');
        var saved = null;
        try {
          saved = sessionStorage.getItem('theme');
        } catch (e) {}
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : defaultMode === 'light' || defaultMode === 'dark'
              ? defaultMode
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <ClientRouter />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, Astro.site)} />)}
    {i18n && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, Astro.site)} />}
  </head>
  <body>
    <header class="site-header">
      <button class="nav-toggle" type="button" aria-label="打开导航菜单 / Menu" aria-expanded="false" aria-controls="site-nav">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="站点导航">
        <p class="site-title"><a href="/">{siteTitle}</a></p>
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.path}
                class:list={[{ active: item.path === currentPath }]}
                aria-current={item.path === currentPath ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="header-tools">
        {bgm && (
          <button class="bgm-toggle icon-btn" type="button" aria-pressed="false" aria-label="播放/暂停背景音乐 / Toggle background music">
            <svg class="icon icon-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
            </svg>
            <svg class="icon icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7" />
              <path d="M18.5 5.5a9.5 9.5 0 0 1 0 13" />
            </svg>
          </button>
        )}
        {i18n && alternates.length > 1 && (
          <div class="lang-switcher">
            <button class="lang-toggle icon-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="语言切换 / Switch language">
              {/* Material translate 图标（fill，与主题按钮同款小方块风格） */}
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z" />
              </svg>
            </button>
            <ul class="lang-menu" role="menu">
              {alternates.map((a) => (
                <li role="none">
                  <a
                    href={a.path}
                    hreflang={a.lang}
                    role="menuitem"
                    class:list={[{ active: a.lang === lang }]}
                    aria-current={a.lang === lang ? 'true' : undefined}
                  >
                    {langLabel(a.lang)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <button class="theme-toggle icon-btn" type="button" aria-label="切换亮色/暗色主题 / Toggle theme">
          <svg class="icon icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="icon icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
          </svg>
        </button>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    {/* 背景音乐：<audio> 跨页面转场常驻（transition:persist），状态见 src/scripts/bgm.ts */}
    {bgm && (
      <audio
        class="bgm-audio"
        src={bgm.src}
        loop
        preload="none"
        data-volume={bgm.volume}
        transition:persist="bgm-audio"
      />
    )}
    {/* 图片灯箱骨架（spec 03 §5）：交互在 src/scripts/lightbox.ts，开/关动画在 global.css */}
    <div class="lightbox" role="dialog" aria-modal="true" aria-label="图片预览 / Image preview" hidden>
      <img class="lightbox-img" alt="" />
      <button class="lightbox-close" type="button" aria-label="关闭 / Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <script>
      // 前端交互入口（主题切换 / 导航抽屉 / 流式播放 / RSS 浮层 / 灯箱 / 动效），astro:page-load 驱动
      import '../scripts/interactions.ts';
    </script>
  </body>
</html>
