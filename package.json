{
  "name": "openhomepage-v2",
  "version": "0.2.0",
  "description": "A lightweight, magazine-style personal homepage generator",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stlin256/OpenHomepage-V2.git"
  },
  "homepage": "https://github.com/stlin256/OpenHomepage-V2#readme",
  "bugs": {
    "url": "https://github.com/stlin256/OpenHomepage-V2/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prefetch": "tsx scripts/prefetch.ts",
    "doctor": "tsx scripts/doctor.ts",
    "dev": "tsx scripts/generate-fonts.ts && astro dev",
    "build": "tsx scripts/generate-fonts.ts && tsx scripts/generate-og-images.ts && astro build && npm run optimize:critical-css && npm run optimize:images",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "setup": "node scripts/setup.mjs",
    "admin": "tsx admin/server/index.ts",
    "preview": "astro preview",
    "serve": "tsx scripts/serve.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "version": "node scripts/sync-version.mjs && git add data.example/pages",
    "generate:fonts": "tsx scripts/generate-fonts.ts",
    "optimize:critical-css": "tsx scripts/optimize-critical-css.ts"
  },
  "keywords": [
    "astro",
    "homepage",
    "portfolio",
    "static-site-generator"
  ],
  "author": "stlin256",
  "license": "MIT",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@milkdown/core": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/preset-gfm": "^7.22.1",
    "@milkdown/prose": "^7.22.1",
    "@milkdown/transformer": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@shikijs/rehype": "^4.4.3",
    "astro": "^7.2.4",
    "js-yaml": "^5.3.0",
    "katex": "^0.18.4",
    "mdast-util-directive": "^3.1.0",
    "prosemirror-history": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "beasties": "^0.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "jimp": "^1.6.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "subset-font": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
